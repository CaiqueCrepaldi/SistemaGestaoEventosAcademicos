# Variaveis de ambiente do frontend. Copie este arquivo para frontend/.env se precisar mudar algo.
# So variaveis com o prefixo VITE_ chegam ao navegador: nunca coloque segredo aqui.

# Endereco da API do backend. Opcional: sem ela, o frontend usa http://localhost:8080/api.
# Em producao, o valor fica nas variaveis de ambiente da Vercel (Settings -> Environment Variables).
VITE_API_URL=http://localhost:8080/api
