# URL base da API do backend (Java/Spring Boot). Só é usada quando VITE_USE_MOCK=false.
VITE_API_URL=http://localhost:8080/api

# true  -> dados mockados em localStorage (services/seed.ts), sem precisar do backend rodando.
# false -> chamadas HTTP reais para VITE_API_URL, com o contrato descrito em docs/api-contract.md.
VITE_USE_MOCK=true
