# Copie este arquivo para ".env" e ajuste os valores. O ".env" nunca é
# commitado (ver .gitignore na raiz do projeto).
#
# Este backend guarda os dados em memória por enquanto — não existe
# variável de banco de dados aqui porque o banco de dados é administrado à
# parte, em outra ferramenta/projeto (ver backend/README.md).

# --- Servidor ---
PORT=8080
NODE_ENV=development

# Origem permitida por CORS — endereço onde o frontend roda.
# Em dev local do Vite costuma ser http://localhost:5173; ajuste conforme a
# porta que aparecer no seu "npm run dev" do frontend.
CORS_ORIGIN=http://localhost:5173

# --- Autenticação (JWT) ---
# Troque por um valor aleatório e longo em qualquer ambiente real —
# qualquer um que souber esse segredo consegue forjar token de admin.
JWT_SECRET="troque-este-valor-por-um-segredo-longo-e-aleatorio"
JWT_EXPIRES_IN=8h

# --- E-mail (SMTP) ---
# Deixe em branco (ou não defina) durante o desenvolvimento: sem SMTP
# configurado, o backend só imprime o e-mail no console em vez de enviar de
# verdade — é o suficiente pra testar o fluxo de inscrição/recuperação de senha.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Gestão de Eventos Acadêmicos <no-reply@sgea.local>"
