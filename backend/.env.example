PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# String de conexao do banco (aba "Connect" do TiDB Cloud -> formato "Prisma").
# Em desenvolvimento, aponte para um banco de DEV/TESTE (ex.: SGEA_dev), nunca para o de producao.
DATABASE_URL="mysql://usuario:senha@host:4000/nome_do_banco?sslaccept=strict"

# Segredo usado pra assinar o JWT de login. Gere um valor aleatorio proprio, nao reaproveite este exemplo.
JWT_SECRET="troque-por-um-segredo-aleatorio"
JWT_EXPIRES_IN=8h

# Chave AES-256 em base64 (32 bytes decodificados): cifra o segredo do 2FA e assina o HMAC dos codigos
# de recuperacao do 2FA e das chaves do limite de tentativas (nome/e-mail/RGM ficam em texto puro).
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar essa chave depois de ja existir 2FA ativado invalida o 2FA e os codigos de recuperacao de todo mundo.
ENCRYPTION_KEY=""

# Opcionais: sem eles, o backend so loga o e-mail no console em vez de enviar de verdade.
SENDGRID_API_KEY=
EMAIL_FROM=
