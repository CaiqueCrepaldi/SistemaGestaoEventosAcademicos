// schema do banco, gerado a partir dos tipos que ja existiam em src/types/domain.ts
// rodar "npm run db:migrate" depois de preencher DATABASE_URL no .env

generator client {
  provider      = "prisma-client-js"
  // "native" pra rodar local, os "rhel-*" pra funcionar dentro da funcao serverless da vercel
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  ADMINISTRADOR
  SECRETARIA
  ALUNO
  // conta criada pela equipe (nome + e-mail @umc.br); cria e organiza os proprios eventos
  PROFESSOR
}

// aprovacao de evento e palestrante criados por professor: nasce PENDENTE, a equipe aprova ou recusa
// (com motivo). O que a equipe cria ja nasce APROVADO; o que existia antes desse controle ficou APROVADO
enum SituacaoAprovacao {
  PENDENTE
  APROVADO
  RECUSADO
}

enum StatusPresenca {
  PENDENTE
  PRESENTE
  AUSENTE
}

// a CONTA de acesso de qualquer perfil e a fonte unica do nome e do e-mail da pessoa — o aluno nao
// repete esses dados no Participante. nome/emailLogin em texto puro (dados pessoais comuns, art. 5º,
// I da LGPD — protegidos por controle de acesso por perfil, HTTPS, banco com acesso restrito e
// auditoria). emailLogin sempre minusculo e sem espaco (normalizado na gravacao e na busca)
model Usuario {
  id                  String        @id
  nome                String        @db.Text
  emailLogin          String        @unique @db.VarChar(255)
  senhaHash           String
  perfil              Perfil
  participanteId      String?
  participante        Participante? @relation(fields: [participanteId], references: [id], onDelete: SetNull)
  // data/hora em que aceitou os termos de uso/politica de privacidade no cadastro (LGPD);
  // null pra contas provisionadas antes desse controle existir (admin/secretaria, seeds antigos)
  consentimentoLgpdEm DateTime?
  // sobe a cada evento que precisa invalidar sessoes ja emitidas (troca de senha, inativacao,
  // exclusao) — o token carrega a versao no momento do login; se nao bater mais com esta coluna,
  // o middleware autenticar recusa mesmo com assinatura/prazo validos. Token antigo (de antes
  // dessa coluna existir) nao carrega versao nenhuma e e tratado como versao 1, o valor inicial
  // de toda conta — ninguem e deslogado por causa da migracao em si, so por uma troca de verdade
  versaoToken         Int           @default(1)
  // versao dos Termos de Uso/Politica de Privacidade aceita por ultimo (ex.: "2"); null pra quem
  // aceitou antes desse controle existir — forca reaceite no proximo login (ver auth.service.ts)
  versaoTermosAceitos String?
  // 2FA por aplicativo autenticador (TOTP, RFC 6238). O segredo fica cifrado com criptografar(),
  // nunca em texto puro nem em log. Segredo preenchido com mfaAtivo=false = configuracao
  // iniciada e ainda nao confirmada com um codigo valido
  mfaAtivo            Boolean       @default(false)
  mfaSegredoCifrado   String?       @db.Text
  // ultimo passo de tempo TOTP aceito (floor(unix/30)): codigo do mesmo passo ou anterior e recusado
  mfaUltimoPasso      Int?
  mfaAtivadoEm        DateTime?
  criadoEm            DateTime      @default(now())

  checkinsFeitos        Inscricao[]            @relation("CheckinFeitoPor")
  recuperacoes          RecuperacaoSenha[]
  logsAuditoria         LogAuditoria[]
  solicitacoesAtendidas SolicitacaoTitular[]
  codigosRecuperacaoMfa CodigoRecuperacaoMfa[]
  eventosCriados        Evento[]               @relation("EventoCriadoPor")
  palestrantesCriados   Palestrante[]          @relation("PalestranteCriadoPor")
  primeiroAcesso        PrimeiroAcesso?
  historicoAprovacoes   HistoricoAprovacao[]

  @@map("usuarios")
}

// os dados de ALUNO (RGM, situacao, inscricoes...). Nome e e-mail ficam so na conta vinculada
// (Usuario ALUNO com participanteId = este id): todo Participante nasce do cadastro da conta
model Participante {
  id               String   @id
  rgm              String   @unique @db.VarChar(20)
  ativo            Boolean  @default(true)
  // 500 e o tamanho real da coluna desde a migration que criou o campo (o schema dizia 191 por engano)
  motivoInativacao String?  @db.VarChar(500)
  criadoEm         DateTime @default(now())

  usuarios     Usuario[]
  inscricoes   Inscricao[]
  feedbacks    Feedback[]
  tentativas   TentativaQuestionario[]
  solicitacoes SolicitacaoTitular[]

  @@map("participantes")
}

model Sala {
  id         String   @id
  nome       String
  capacidade Int
  eventos    Evento[]

  @@map("salas")
}

// nome/email em texto puro por decisao (nao sao sensiveis, edicao restrita a
// equipe, nome ja e publico na agenda) — ver docs/lgpd/07-medidas-tecnicas-de-seguranca.md
model Palestrante {
  id           String            @id
  nome         String
  email        String            @unique
  eventos      Evento[]
  // aprovacao (ver SituacaoAprovacao). motivoRecusa = o da ultima recusa, apagado ao reenviar/aprovar;
  // o historico completo fica em historico_aprovacoes. criadoPorId null = criado pela equipe
  situacao     SituacaoAprovacao @default(APROVADO)
  motivoRecusa String?           @db.Text
  criadoPorId  String?
  criadoPor    Usuario?          @relation("PalestranteCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@map("palestrantes")
}

// questionario fica como json (10 perguntas com 4 alternativas cada) em vez de tabela
// separada — nunca e consultado pergunta a pergunta, so lido/gravado inteiro
model Evento {
  id            String            @id
  titulo        String
  horario       DateTime
  salaId        String
  sala          Sala              @relation(fields: [salaId], references: [id], onDelete: Restrict)
  palestranteId String
  palestrante   Palestrante       @relation(fields: [palestranteId], references: [id], onDelete: Restrict)
  tema          String
  cargaHoraria  Float
  questionario  Json
  criadoEm      DateTime          @default(now())
  // aprovacao (ver SituacaoAprovacao): so APROVADO aparece pro aluno e conta no Dashboard; PENDENTE ja
  // reserva a sala, RECUSADO libera. criadoPorId = o professor que criou; null = criado pela equipe
  situacao      SituacaoAprovacao @default(APROVADO)
  motivoRecusa  String?           @db.Text
  criadoPorId   String?
  criadoPor     Usuario?          @relation("EventoCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  inscricoes Inscricao[]
  feedbacks  Feedback[]
  tentativas TentativaQuestionario[]

  @@map("eventos")
}

model Inscricao {
  id             String         @id
  participanteId String
  participante   Participante   @relation(fields: [participanteId], references: [id], onDelete: Restrict)
  eventoId       String
  evento         Evento         @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  statusPresenca StatusPresenca @default(PENDENTE)
  dataCheckin    DateTime?
  usuarioId      String?
  usuario        Usuario?       @relation("CheckinFeitoPor", fields: [usuarioId], references: [id], onDelete: SetNull)
  dataInscricao  DateTime       @default(now())
  certificado    Certificado?

  @@unique([participanteId, eventoId])
  @@map("inscricoes")
}

// certificado emitido (RF018/RF019): gravado na PRIMEIRA emissao e devolvido igual nas seguintes
// (nunca e regerado). Os dados impressos ficam copiados aqui (snapshot) de proposito: o documento
// emitido nao muda se o evento for editado ou o nome do aluno for corrigido depois, e a validacao
// publica (RF027) confere exatamente o que foi impresso. codigoValidacao e aleatorio (crypto),
// sem relacao com nenhum id interno. onDelete: Restrict — a inscricao de um certificado emitido
// nao pode ser apagada (senao o codigo impresso deixaria de validar)
model Certificado {
  id               String    @id
  inscricaoId      String    @unique
  inscricao        Inscricao @relation(fields: [inscricaoId], references: [id], onDelete: Restrict)
  codigoValidacao  String    @unique @db.VarChar(20)
  nomeParticipante String    @db.Text
  rgm              String    @db.VarChar(20)
  tituloEvento     String
  temaEvento       String
  nomePalestrante  String
  dataEvento       DateTime
  cargaHoraria     Float
  emitidoEm        DateTime  @default(now())

  @@map("certificados")
}

model Feedback {
  id             String       @id
  eventoId       String
  evento         Evento       @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  participanteId String
  participante   Participante @relation(fields: [participanteId], references: [id], onDelete: Restrict)
  nota           Int
  comentario     String       @db.Text
  criadoEm       DateTime     @default(now())

  @@unique([participanteId, eventoId])
  @@map("feedbacks")
}

// cadastro de aluno esperando a confirmacao do e-mail institucional: a conta (Participante + Usuario)
// so e criada quando o codigo de 6 digitos enviado ao e-mail confere. Guarda provisoriamente os dados
// digitados no formulario por ate 15 minutos (expiraEm); a linha e apagada ao concluir o cadastro ou
// depois de expirar (no proprio cadastro e a cada login — sem rotina agendada). Senha e codigo so
// como hash bcrypt, nunca em texto puro. Tabela isolada (sem relacao com as outras): o login e o
// resto do sistema nao dependem dela
model CadastroPendente {
  id            String   @id
  nome          String   @db.Text
  emailLogin    String   @unique @db.VarChar(255)
  rgm           String   @db.VarChar(20)
  senhaHash     String
  codigoHash    String
  // erros de digitacao do codigo atual; no 5º erro o codigo deixa de valer (zera no reenvio)
  tentativas    Int      @default(0)
  // quantos codigos ja foram enviados pra este cadastro (o primeiro + os reenvios)
  envios        Int      @default(1)
  ultimoEnvioEm DateTime @default(now())
  // instante do aceite dos Termos/Politica no formulario e a versao aceita: vao pra conta ao confirmar
  aceiteEm      DateTime
  versaoTermos  String   @db.VarChar(20)
  expiraEm      DateTime
  criadoEm      DateTime @default(now())

  @@index([rgm])
  @@index([expiraEm])
  @@map("cadastros_pendentes")
}

model RecuperacaoSenha {
  id         String    @id
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  // hash bcrypt do codigo (nunca texto puro); tentativas conta erros de confirmacao
  codigoHash String
  tentativas Int       @default(0)
  expiraEm   DateTime
  usadoEm    DateTime?
  criadoEm   DateTime  @default(now())

  @@map("recuperacoes_senha")
}

// respostas[i] = indice da alternativa escolhida na pergunta i, mesma ordem do questionario do evento
// guardado como Json (array de numeros) porque mysql nao tem coluna de array nativa
model TentativaQuestionario {
  id             String       @id
  participanteId String
  participante   Participante @relation(fields: [participanteId], references: [id], onDelete: Restrict)
  eventoId       String
  evento         Evento       @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  respostas      Json
  acertos        Int
  totalPerguntas Int
  percentual     Int
  criadoEm       DateTime     @default(now())

  @@map("tentativas_questionario")
}

// trilha de auditoria (login, mudanca em registro critico) — exigencia de LGPD/seguranca.
// "acao" eh um codigo curto (LOGIN_SUCESSO, PARTICIPANTE_INATIVADO etc.), "detalhe" nunca
// guarda dado sensivel (senha, token, PII bruta) — so contexto operacional.
// o log nao e apagado nem editado: excluir o usuario so zera usuarioId (SetNull), e atorNome
// (copia do nome de quem agiu, tirada na hora do log) mantem quem foi
model LogAuditoria {
  id        String   @id
  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  atorNome  String?  @db.Text
  acao      String
  detalhe   String?  @db.Text
  criadoEm  DateTime @default(now())

  @@index([criadoEm])
  @@map("logs_auditoria")
}

// bloqueio temporario por excesso de tentativas (login e solicitacao de recuperacao de senha),
// por conta (chave = "login:conta:<HMAC do e-mail>") e por IP (chave = "login:ip:<ip>") — nao
// guarda e-mail em texto puro, so o HMAC dele (indiceBusca, calculado na hora). Zera sozinho: quando o
// bloqueio expira, a proxima checagem reseta os contadores (nao precisa de rotina agendada)
model LimiteAcesso {
  id           String    @id
  chave        String    @unique
  tentativas   Int       @default(0)
  bloqueadoAte DateTime?
  atualizadoEm DateTime  @updatedAt

  @@map("limites_acesso")
}

// pedido do titular (art. 18 LGPD) feito pela pagina "Meus dados" ou pelo canal de privacidade.
// ACESSO/EXPORTACAO/CORRECAO/EXCLUSAO sao resolvidos na hora (status ATENDIDA automatico); so
// REVISAO_DECISAO_AUTOMATIZADA e OPOSICAO/OUTRO ficam ABERTA ate a equipe responder
model SolicitacaoTitular {
  id             String       @id
  participanteId String
  participante   Participante @relation(fields: [participanteId], references: [id], onDelete: Cascade)
  tipo           String
  status         String       @default("ABERTA")
  descricao      String?      @db.Text
  resposta       String?      @db.Text
  atendidoPorId  String?
  atendidoPor    Usuario?     @relation(fields: [atendidoPorId], references: [id], onDelete: SetNull)
  criadoEm       DateTime     @default(now())
  atendidoEm     DateTime?

  @@index([participanteId])
  @@index([status])
  @@map("solicitacoes_titular")
}

// codigos de recuperacao do 2FA: 8 por ativacao, mostrados uma vez so, cada um vale uma vez.
// So o hash (HMAC-SHA256 com a chave do servidor) fica gravado, nunca o codigo
model CodigoRecuperacaoMfa {
  id         String    @id
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  codigoHash String
  usadoEm    DateTime?
  criadoEm   DateTime  @default(now())

  @@index([usuarioId])
  @@map("codigos_recuperacao_mfa")
}

// codigo do primeiro acesso do professor (a conta nasce sem senha utilizavel e sem aceite dos Termos).
// So o hash bcrypt do codigo; vale 24 horas e deixa de valer na 5a tentativa errada. A linha sai quando o
// professor conclui o primeiro acesso
model PrimeiroAcesso {
  id            String   @id
  usuarioId     String   @unique
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  codigoHash    String
  tentativas    Int      @default(0)
  envios        Int      @default(1)
  ultimoEnvioEm DateTime @default(now())
  expiraEm      DateTime
  criadoEm      DateTime @default(now())

  @@map("primeiros_acessos")
}

// historico da aprovacao de cada evento/palestrante: envio, aprovacao, recusa (com o motivo) e reenvio
// (com a resposta opcional do professor), com data e autor. autorNome e a copia do nome de quem agiu,
// como no log de auditoria (o registro continua dizendo quem foi mesmo se a conta sair)
model HistoricoAprovacao {
  id        String   @id
  // EVENTO ou PALESTRANTE
  tipo      String   @db.VarChar(20)
  itemId    String   @db.VarChar(191)
  // ENVIADO, APROVADO, RECUSADO ou REENVIADO
  acao      String   @db.VarChar(20)
  // motivo da recusa ou resposta do professor no reenvio
  mensagem  String?  @db.Text
  autorId   String?
  autor     Usuario? @relation(fields: [autorId], references: [id], onDelete: SetNull)
  autorNome String?  @db.Text
  criadoEm  DateTime @default(now())

  @@index([tipo, itemId])
  @@map("historico_aprovacoes")
}
