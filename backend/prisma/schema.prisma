// schema do banco, gerado a partir dos tipos que ja existiam em src/types/domain.ts
// rodar "npm run db:migrate" depois de preencher DATABASE_URL no .env

generator client {
  provider      = "prisma-client-js"
  // "native" pra rodar local, os "rhel-*" pra funcionar dentro da funcao serverless da vercel
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  ADMINISTRADOR
  SECRETARIA
  ALUNO
}

enum StatusPresenca {
  PENDENTE
  PRESENTE
  AUSENTE
}

// nome/emailLogin/rgm em texto puro (dados pessoais comuns, art. 5º, I da LGPD — protegidos por
// controle de acesso por perfil, HTTPS, banco com acesso restrito e auditoria). Registros antigos
// ainda podem estar no formato cifrado ate rodar scripts/converter-dados-pessoais.ts.
// emailLoginHash eh o indice usado pra login/duplicidade enquanto a conversao nao termina
model Usuario {
  id             String   @id
  nome           String   @db.Text
  emailLogin     String   @db.Text
  emailLoginHash String   @unique
  senhaHash      String
  perfil         Perfil
  rgm            String?  @db.Text
  participanteId String?
  participante   Participante? @relation(fields: [participanteId], references: [id], onDelete: SetNull)
  // data/hora em que aceitou os termos de uso/politica de privacidade no cadastro (LGPD);
  // null pra contas provisionadas antes desse controle existir (admin/secretaria, seeds antigos)
  consentimentoLgpdEm DateTime?
  // sobe a cada evento que precisa invalidar sessoes ja emitidas (troca de senha, inativacao,
  // exclusao) — o token carrega a versao no momento do login; se nao bater mais com esta coluna,
  // o middleware autenticar recusa mesmo com assinatura/prazo validos. Token antigo (de antes
  // dessa coluna existir) nao carrega versao nenhuma e e tratado como versao 1, o valor inicial
  // de toda conta — ninguem e deslogado por causa da migracao em si, so por uma troca de verdade
  versaoToken    Int      @default(1)
  // versao dos Termos de Uso/Politica de Privacidade aceita por ultimo (ex.: "2"); null pra quem
  // aceitou antes desse controle existir — forca reaceite no proximo login (ver auth.service.ts)
  versaoTermosAceitos String?
  // 2FA por aplicativo autenticador (TOTP, RFC 6238). O segredo fica cifrado com criptografar(),
  // nunca em texto puro nem em log. Segredo preenchido com mfaAtivo=false = configuracao
  // iniciada e ainda nao confirmada com um codigo valido
  mfaAtivo          Boolean   @default(false)
  mfaSegredoCifrado String?   @db.Text
  // ultimo passo de tempo TOTP aceito (floor(unix/30)): codigo do mesmo passo ou anterior e recusado
  mfaUltimoPasso    Int?
  mfaAtivadoEm      DateTime?
  criadoEm       DateTime @default(now())

  checkinsFeitos  Inscricao[]        @relation("CheckinFeitoPor")
  recuperacoes    RecuperacaoSenha[]
  logsAuditoria   LogAuditoria[]
  solicitacoesAtendidas SolicitacaoTitular[]
  codigosRecuperacaoMfa CodigoRecuperacaoMfa[]

  @@map("usuarios")
}

// nome/email/rgm em texto puro (mesma decisao do Usuario); emailHash/rgmHash sao os indices usados
// pra checagem de duplicidade enquanto a conversao dos registros antigos nao termina
model Participante {
  id        String   @id
  nome      String   @db.Text
  email     String   @db.Text
  emailHash String   @unique
  rgm       String   @db.Text
  rgmHash   String   @unique
  ativo     Boolean  @default(true)
  // 500 e o tamanho real da coluna desde a migration que criou o campo (o schema dizia 191 por engano)
  motivoInativacao String? @db.VarChar(500)
  criadoEm  DateTime @default(now())

  usuarios   Usuario[]
  inscricoes Inscricao[]
  feedbacks  Feedback[]
  tentativas TentativaQuestionario[]
  solicitacoes SolicitacaoTitular[]

  @@map("participantes")
}

model Sala {
  id         String   @id
  nome       String
  capacidade Int
  eventos    Evento[]

  @@map("salas")
}

// nome/email em texto puro por decisao (nao sao sensiveis, edicao restrita a
// equipe, nome ja e publico na agenda) — ver docs/lgpd/07-medidas-tecnicas-de-seguranca.md
model Palestrante {
  id      String   @id
  nome    String
  email   String   @unique
  eventos Evento[]

  @@map("palestrantes")
}

// questionario fica como json (10 perguntas com 4 alternativas cada) em vez de tabela
// separada — nunca e consultado pergunta a pergunta, so lido/gravado inteiro
model Evento {
  id            String   @id
  titulo        String
  horario       DateTime
  salaId        String
  sala          Sala     @relation(fields: [salaId], references: [id], onDelete: Restrict)
  palestranteId String
  palestrante   Palestrante @relation(fields: [palestranteId], references: [id], onDelete: Restrict)
  tema          String
  cargaHoraria  Float
  questionario  Json
  criadoEm      DateTime @default(now())

  inscricoes Inscricao[]
  feedbacks  Feedback[]
  tentativas TentativaQuestionario[]

  @@map("eventos")
}

model Inscricao {
  id             String         @id
  participanteId String
  participante   Participante   @relation(fields: [participanteId], references: [id], onDelete: Restrict)
  eventoId       String
  evento         Evento         @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  statusPresenca StatusPresenca @default(PENDENTE)
  dataCheckin    DateTime?
  usuarioId      String?
  usuario        Usuario?       @relation("CheckinFeitoPor", fields: [usuarioId], references: [id], onDelete: SetNull)
  dataInscricao  DateTime       @default(now())

  @@unique([participanteId, eventoId])
  @@map("inscricoes")
}

model Feedback {
  id             String       @id
  eventoId       String
  evento         Evento       @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  participanteId String
  participante   Participante @relation(fields: [participanteId], references: [id], onDelete: Restrict)
  nota           Int
  comentario     String       @db.Text
  criadoEm       DateTime     @default(now())

  @@unique([participanteId, eventoId])
  @@map("feedbacks")
}

model RecuperacaoSenha {
  id         String    @id
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  // hash bcrypt do codigo (nunca texto puro); tentativas conta erros de confirmacao
  codigoHash String
  tentativas Int       @default(0)
  expiraEm   DateTime
  usadoEm    DateTime?
  criadoEm   DateTime  @default(now())

  @@map("recuperacoes_senha")
}

// respostas[i] = indice da alternativa escolhida na pergunta i, mesma ordem do questionario do evento
// guardado como Json (array de numeros) porque mysql nao tem coluna de array nativa
model TentativaQuestionario {
  id             String       @id
  participanteId String
  participante   Participante @relation(fields: [participanteId], references: [id], onDelete: Restrict)
  eventoId       String
  evento         Evento       @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  respostas      Json
  acertos        Int
  totalPerguntas Int
  percentual     Int
  criadoEm       DateTime     @default(now())

  @@map("tentativas_questionario")
}

// trilha de auditoria (login, mudanca em registro critico) — exigencia de LGPD/seguranca.
// "acao" eh um codigo curto (LOGIN_SUCESSO, PARTICIPANTE_INATIVADO etc.), "detalhe" nunca
// guarda dado sensivel (senha, token, PII bruta) — so contexto operacional.
// o log nao e apagado nem editado: excluir o usuario so zera usuarioId (SetNull), e atorNome
// (copia do nome de quem agiu, tirada na hora do log) mantem quem foi. atorNomeCifrado e a mesma
// copia no formato antigo (cifrado): o script de conversao move pra atorNome e a coluna sai depois
model LogAuditoria {
  id        String   @id
  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  atorNome        String? @db.Text
  atorNomeCifrado String? @db.Text
  acao      String
  detalhe   String?  @db.Text
  criadoEm  DateTime @default(now())

  @@index([criadoEm])
  @@map("logs_auditoria")
}

// bloqueio temporario por excesso de tentativas (login e solicitacao de recuperacao de senha),
// por conta (chave = "login:conta:<emailLoginHash>") e por IP (chave = "login:ip:<ip>") — nao
// guarda e-mail em texto puro, so o indice de busca ja usado pra login. Zera sozinho: quando o
// bloqueio expira, a proxima checagem reseta os contadores (nao precisa de rotina agendada)
model LimiteAcesso {
  id           String    @id
  chave        String    @unique
  tentativas   Int       @default(0)
  bloqueadoAte DateTime?
  atualizadoEm DateTime  @updatedAt

  @@map("limites_acesso")
}

// pedido do titular (art. 18 LGPD) feito pela pagina "Meus dados" ou pelo canal de privacidade.
// ACESSO/EXPORTACAO/CORRECAO/EXCLUSAO sao resolvidos na hora (status ATENDIDA automatico); so
// REVISAO_DECISAO_AUTOMATIZADA e OPOSICAO/OUTRO ficam ABERTA ate a equipe responder
model SolicitacaoTitular {
  id             String    @id
  participanteId String
  participante   Participante @relation(fields: [participanteId], references: [id], onDelete: Cascade)
  tipo           String
  status         String    @default("ABERTA")
  descricao      String?   @db.Text
  resposta       String?   @db.Text
  atendidoPorId  String?
  atendidoPor    Usuario?  @relation(fields: [atendidoPorId], references: [id], onDelete: SetNull)
  criadoEm       DateTime  @default(now())
  atendidoEm     DateTime?

  @@index([participanteId])
  @@index([status])
  @@map("solicitacoes_titular")
}

// codigos de recuperacao do 2FA: 8 por ativacao, mostrados uma vez so, cada um vale uma vez.
// So o hash (HMAC-SHA256 com a chave do servidor) fica gravado, nunca o codigo
model CodigoRecuperacaoMfa {
  id         String    @id
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  codigoHash String
  usadoEm    DateTime?
  criadoEm   DateTime  @default(now())

  @@index([usuarioId])
  @@map("codigos_recuperacao_mfa")
}
